{
  "name": "authd",
  "version": "0.0.0",
  "description": "TOTP codes on the desktop, so a phone never has to be unlocked for a 2FA code",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build ui/ts/main.ts --target=browser --format=esm --minify --outdir=ui/src/js",
    "watch": "bun build ui/ts/main.ts --target=browser --format=esm --outdir=ui/src/js --watch",
    "dev": "bun run build && cd tauri && cargo run",
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test ui/ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.5",
    "@types/bun": "1.3.10",
    "typescript": "5.9.3"
  }
}
